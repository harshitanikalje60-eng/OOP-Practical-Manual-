#include <iostream>
#include <memory>
#include <string>
using namespace std;
 
struct Resource {
    string name;
    Resource(string n) : name(n) { cout << "  [+] Resource " << name << " created\n"; }
    ~Resource() { cout << "  [-] Resource " << name << " destroyed\n"; }
};
 
int main() {
    cout << "--- unique_ptr (single owner) ---\n";
    {
        unique_ptr<Resource> u1 = make_unique<Resource>("U1");
        unique_ptr<Resource> u2 = move(u1);   // ownership transferred
        cout << "  u1 is " << (u1 ? "not null" : "null") << ", u2 owns " << u2->name << "\n";
    }
    cout << "--- shared_ptr (shared ownership) ---\n";
    {
        shared_ptr<Resource> s1 = make_shared<Resource>("S1");
        cout << "  use_count = " << s1.use_count() << "\n";
        {
            shared_ptr<Resource> s2 = s1;
            cout << "  use_count = " << s1.use_count() << " (s2 shares)\n";
        }
        cout << "  use_count = " << s1.use_count() << " (s2 out of scope)\n";
    }
    cout << "--- unique_ptr array, 100000 iterations ---\n";
    for (int i = 0; i < 100000; i++) { unique_ptr<int[]> arr(new int[100]); arr[0] = i; }
    cout << "  Done, no manual delete used\n";
    return 0;
}
