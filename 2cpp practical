#include <iostream>
#include <string>
using namespace std;
 
class BankAccount {
private:                       // hidden from outside: protects data from direct modification
    int accNo;
    string holder;
    double balance;
public:                        // interface used by main()
    BankAccount(int no, string h, double bal) : accNo(no), holder(h), balance(bal >= 0 ? bal : 0) {}
    void deposit(double amt) {
        if (amt <= 0) { cout << "Invalid deposit amount\n"; return; }
        balance += amt;
        cout << "Deposited " << amt << "\n";
    }
    void withdraw(double amt) {
        if (amt <= 0 || amt > balance) { cout << "Withdraw failed (amount " << amt << ")\n"; return; }
        balance -= amt;
        cout << "Withdrew " << amt << "\n";
    }
    void display() const {
        cout << "Acc No: " << accNo << " | Holder: " << holder << " | Balance: " << balance << "\n";
    }
};
 
int main() {
    BankAccount a1(101, "Amit", 5000), a2(102, "Sneha", 12000);
    cout << "--- Account 1 ---\n";
    a1.display(); a1.deposit(1500); a1.withdraw(2000); a1.withdraw(10000); a1.display();
    cout << "\n--- Account 2 ---\n";
    a2.display(); a2.deposit(-50); a2.withdraw(4000); a2.display();
    return 0;
}
