#include <iostream>
#include <stack>
#include <string>
#include <stdexcept>
using namespace std;
 
template <typename T>
class Stack {
    stack<T> st;
public:
    void push(const T& v) { st.push(v); }
    T pop() {
        if (st.empty()) throw runtime_error("Stack is empty");
        T v = st.top(); st.pop(); return v;
    }
    const T& top() const { if (st.empty()) throw runtime_error("Stack is empty"); return st.top(); }
    bool empty() const { return st.empty(); }
};
 
template <typename T>
void test(const string& label, T a, T b, T c) {
    Stack<T> s;
    s.push(a); s.push(b); s.push(c);
    cout << label << " stack: top = " << s.top() << "\n  pop order: ";
    while (!s.empty()) cout << s.pop() << " ";
    cout << "\n";
    try { s.pop(); } catch (const exception& e) { cout << "  Error on empty pop: " << e.what() << "\n"; }
}
 
int main() {
    test<int>("int", 10, 20, 30);
    test<float>("float", 1.5f, 2.5f, 3.5f);
    test<string>("string", "one", "two", "three");
    return 0;
}
